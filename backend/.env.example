NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_RECONNECT_PERIOD=5000
MQTT_CONNECT_TIMEOUT=10000
MQTT_CLEAN=true

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=YOUR_TOKEN
INFLUX_ORG=YOUR_ORG
INFLUX_BUCKET=coldrooms

# Required: replace with a private value containing at least 32 UTF-8 bytes.
BIOEMS_JWT_SECRET=

# Optional JWT overrides; these values match the application defaults.
BIOEMS_JWT_EXPIRE_MINUTES=30
BIOEMS_JWT_ISSUER=bio-ems
BIOEMS_JWT_AUDIENCE=bio-ems-api

# Required for the isolated SYSTEM_OWNER login boundary. Generate a separate
# private value containing at least 32 UTF-8 bytes.
BIOEMS_PLATFORM_JWT_SECRET=
BIOEMS_PLATFORM_JWT_EXPIRE_MINUTES=60
BIOEMS_PLATFORM_JWT_ISSUER=bio-ems-platform
BIOEMS_PLATFORM_JWT_AUDIENCE=bio-ems-platform-api

# Required only while running `npm run bootstrap:admin` for the first User.
BIOEMS_BOOTSTRAP_ADMIN_USERNAME=
BIOEMS_BOOTSTRAP_ADMIN_PASSWORD=

# Optional bootstrap email.
BIOEMS_BOOTSTRAP_ADMIN_EMAIL=

# Comma-separated exact browser origins. Production defaults to an empty allowlist.
BIOEMS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production: use absolute persistent-volume and separate backup-directory paths.
BIOEMS_SQLITE_PATH=
BIOEMS_SQLITE_BACKUP_DIR=

# Production operational controls validated by `npm run validate:deployment`.
LOG_LEVEL=info
BIOEMS_LOG_RETENTION_DAYS=90
BIOEMS_SHUTDOWN_GRACE_SECONDS=30

# Durable notification delivery runtime. Enable only after at least one complete
# provider block below has been configured.
BIOEMS_NOTIFICATION_DELIVERY_ENABLED=false
BIOEMS_NOTIFICATION_POLL_INTERVAL_MS=2000
BIOEMS_NOTIFICATION_TIMEOUT_MS=15000

# Primary email provider (Gmail example: smtp.gmail.com, port 465, secure true).
BIOEMS_EMAIL_SMTP_HOST=
BIOEMS_EMAIL_SMTP_PORT=465
BIOEMS_EMAIL_SMTP_SECURE=true
BIOEMS_EMAIL_SMTP_USERNAME=
BIOEMS_EMAIL_SMTP_PASSWORD=
BIOEMS_EMAIL_FROM=

# Used only by `npm run test:email-delivery`; prefer setting it temporarily in
# the PowerShell process instead of storing a real recipient in this file.
BIOEMS_EMAIL_TEST_RECIPIENT=

# Telegram is available as an independent primary channel while Meta WhatsApp
# onboarding is blocked. Never commit the real Bot Token or Chat ID.
BIOEMS_TELEGRAM_BOT_TOKEN=
# Used only by `npm run test:telegram-delivery`; set it temporarily in the shell.
BIOEMS_TELEGRAM_TEST_CHAT_ID=

# Primary WhatsApp provider (Meta WhatsApp Cloud API approved template).
BIOEMS_WHATSAPP_PHONE_NUMBER_ID=
BIOEMS_WHATSAPP_ACCESS_TOKEN=
BIOEMS_WHATSAPP_TEMPLATE_NAME=
BIOEMS_WHATSAPP_TEMPLATE_LANGUAGE=en_US
BIOEMS_WHATSAPP_GRAPH_VERSION=v23.0

# Optional SMS fallback provider.
BIOEMS_SMS_PROVIDER_URL=
BIOEMS_SMS_PROVIDER_TOKEN=
BIOEMS_SMS_PROVIDER_NAME=PILOT_SMS
