NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

MQTT_HOST=localhost
MQTT_PORT=1883

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=YOUR_TOKEN
INFLUX_ORG=YOUR_ORG
INFLUX_BUCKET=coldrooms

# Required: replace with a private value containing at least 32 UTF-8 bytes.
BIOEMS_JWT_SECRET=

# Optional JWT overrides; these values match the application defaults.
BIOEMS_JWT_EXPIRE_MINUTES=30
BIOEMS_JWT_ISSUER=bio-ems
BIOEMS_JWT_AUDIENCE=bio-ems-api

# Required only while running `npm run bootstrap:admin` for the first User.
BIOEMS_BOOTSTRAP_ADMIN_USERNAME=
BIOEMS_BOOTSTRAP_ADMIN_PASSWORD=

# Optional bootstrap email.
BIOEMS_BOOTSTRAP_ADMIN_EMAIL=

# Comma-separated exact browser origins. Production defaults to an empty allowlist.
BIOEMS_CORS_ALLOWED_ORIGINS=http://localhost:5173
