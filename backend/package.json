{
  "name": "bio-ems-backend",
  "version": "0.13.0",
  "description": "BIO-EMS Enterprise Environmental Monitoring Backend",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "author": "Ahmed A. Elsheikh",
  "license": "Proprietary",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bio-ems",
    "environmental-monitoring",
    "temperature-monitoring",
    "cold-room",
    "iot"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src database",
    "lint:fix": "eslint src database --fix",
    "format": "prettier --write \"{src,database}/**/*.ts\" \"*.{json,js}\"",
    "format:check": "prettier --check \"{src,database}/**/*.ts\" \"*.{json,js}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  }
}
