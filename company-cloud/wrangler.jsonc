{
  "name": "bioems-company",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bioems-company",
      "database_id": "21d37686-0ae1-4e17-b995-388131d29e86",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
}
