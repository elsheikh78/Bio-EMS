{
  "schemaVersion": 1,
  "workPackage": "DEP-01",
  "phase": "PROTECTED_CONFIGURATION_AND_SERVICE_LIFECYCLE",
  "target": {
    "operatingSystem": "Windows 11 Pro",
    "architecture": "x64",
    "administratorRequired": true
  },
  "installerTechnology": "Inno Setup 6",
  "output": "single-offline-setup-exe",
  "requiredArtifactIds": [
    "backend",
    "frontend",
    "node",
    "mosquitto",
    "influxdb",
    "winsw"
  ],
  "persistentRoot": "C:\\ProgramData\\BIO-EMS",
  "applicationRoot": "C:\\Program Files\\BIO-EMS",
  "services": ["BIOEMS-Backend", "BIOEMS-MQTT", "BIOEMS-InfluxDB"],
  "serviceAccounts": {
    "BIOEMS-Backend": "NT SERVICE\\BIOEMS-Backend",
    "BIOEMS-MQTT": "NT SERVICE\\BIOEMS-MQTT",
    "BIOEMS-InfluxDB": "NT SERVICE\\BIOEMS-InfluxDB"
  },
  "protectedConfiguration": "C:\\ProgramData\\BIO-EMS\\config\\backend.env",
  "licensingIdentityOwner": "NT SERVICE\\BIOEMS-Backend",
  "publicPorts": [443],
  "internalPorts": [3001, 8086, 8883],
  "frontDoor": {
    "protocol": "https",
    "port": 443,
    "firewallProfiles": ["Domain", "Private"],
    "remoteAddressScope": "LocalSubnet"
  },
  "postInstallHealthEvidence": "C:\\ProgramData\\BIO-EMS\\logs\\post-install-health.json",
  "forbiddenPayloadPatterns": [
    ".env",
    "identity.json",
    "license.json",
    "activation-receipt.json",
    "*.private.pem"
  ],
  "qualificationRequired": true
}
