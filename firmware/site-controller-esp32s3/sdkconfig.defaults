CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
# Certificate is transferred from the installed customer platform during USB provisioning.
# No unauthenticated server-certificate fallback is permitted.
# CONFIG_ESP_TLS_INSECURE is not set
# CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY is not set

CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_MBEDTLS_GCM_C=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
