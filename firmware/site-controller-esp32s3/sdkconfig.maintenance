# Designated-board profile only. No Secure Boot/encryption keys or eFuse activation.
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.maintenance.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BIOEMS_USB_AB_MAINTENANCE=y
CONFIG_BIOEMS_UPDATE_CONFIRM_SECONDS=180
