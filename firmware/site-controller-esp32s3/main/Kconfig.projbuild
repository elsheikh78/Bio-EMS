menu "BIO-EMS W5500 bench wiring"
config BIOEMS_ETH_MOSI
    int "W5500 MOSI GPIO"
    default 11
config BIOEMS_ETH_MISO
    int "W5500 MISO GPIO"
    default 13
config BIOEMS_ETH_SCLK
    int "W5500 SCLK GPIO"
    default 12
config BIOEMS_ETH_CS
    int "W5500 chip select GPIO"
    default 10
endmenu

menu "BIO-EMS RTC and 2G bench interfaces"
config BIOEMS_RTC_ENABLED
    bool "Enable DS3231 UTC clock"
    default y
config BIOEMS_RTC_SDA
    int "DS3231 SDA GPIO"
    default 8
config BIOEMS_RTC_SCL
    int "DS3231 SCL GPIO"
    default 9
config BIOEMS_GSM_ENABLED
    bool "Enable SIM800L bench diagnostics and explicit SMS command"
    default y
config BIOEMS_GSM_TX
    int "SIM800L UART2 TX GPIO (through divider)"
    default 14
config BIOEMS_GSM_RX
    int "SIM800L UART2 RX GPIO (through NPN inverter)"
    default 21
config BIOEMS_GSM_RX_INVERTED
    bool "Invert RX for the specified external NPN circuit"
    default y
endmenu

menu "BIO-EMS offline SD storage"
config BIOEMS_SD_ENABLED
    bool "Enable SD store and forward (requires wired card)"
    default y
config BIOEMS_SD_MOSI
    int "SD MOSI GPIO (SPI3)"
    default 4
config BIOEMS_SD_MISO
    int "SD MISO GPIO (SPI3)"
    default 5
config BIOEMS_SD_SCLK
    int "SD SCLK GPIO (SPI3)"
    default 6
config BIOEMS_SD_CS
    int "SD CS GPIO (SPI3)"
    default 7
config BIOEMS_SD_QUEUE_RECORDS
    int "Maximum queued four-channel samples"
    range 1 20000
    default 20000
endmenu
